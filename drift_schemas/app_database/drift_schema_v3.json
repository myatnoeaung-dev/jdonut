  "fixed_sql": [
    {
      "name": "users",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"phone_number\" TEXT NOT NULL UNIQUE, \"first_name\" TEXT NOT NULL, \"last_name\" TEXT NULL, \"birth_date\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL DEFAULT (CURRENT_TIMESTAMP));"
        }
      ]
    },
    {
      "name": "products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" TEXT NOT NULL, \"code\" TEXT NOT NULL UNIQUE, \"name\" TEXT NOT NULL, \"price_mmk\" INTEGER NOT NULL, \"is_new\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_new\" IN (0, 1)), \"discount_percent\" INTEGER NULL, \"image_url\" TEXT NOT NULL, \"description\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "banners",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"banners\" (\"id\" TEXT NOT NULL, \"tag\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"image_url\" TEXT NOT NULL, \"shows_shop_icon\" INTEGER NOT NULL DEFAULT 0 CHECK (\"shows_shop_icon\" IN (0, 1)), \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "home_section_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"home_section_items\" (\"section_id\" TEXT NOT NULL, \"product_id\" TEXT NOT NULL REFERENCES products (id), \"position\" INTEGER NOT NULL, PRIMARY KEY (\"section_id\", \"product_id\"));"
        }
      ]
    },
    {
      "name": "shops",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shops\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"address\" TEXT NOT NULL, \"image_url\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "members",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"members\" (\"id\" TEXT NOT NULL, \"tier\" TEXT NOT NULL, \"loyalty_points\" INTEGER NOT NULL, \"next_tier_points\" INTEGER NOT NULL, \"unread_notifications\" INTEGER NOT NULL DEFAULT 0, \"avatar_url\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
